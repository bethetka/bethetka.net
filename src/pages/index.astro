---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="grid min-h-screen place-items-center p-5">
    <article class="studio-card grid w-full max-w-3xl border border-border bg-card md:grid-cols-[1.2fr_1fr]">
      <section class="flex min-h-60 flex-col justify-center p-8 md:p-10">
        <h1 class="text-3xl font-bold tracking-tight">bethetka</h1>
        <p class="mt-3 text-sm leading-6 text-muted">independent studio &amp; hackathon team</p>
      </section>

      <aside class="flex flex-col justify-center border-t border-border p-8 md:border-t-0 md:p-10">
        <h2 class="mb-4 text-xs font-bold text-muted uppercase">Links</h2>
        <a
          class="flex items-center gap-3 border border-border bg-page px-3 py-2 text-sm hover:border-accent hover:text-accent"
          href="https://github.com/bethetka"
          target="_blank"
          rel="noreferrer"
        >
          <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-4.3 1.4-4.3-2.5-6-3" />
            <path d="M15 22v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 0 0 4 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22" />
          </svg>
          <span>github.com/bethetka</span>
        </a>
        <a
          class="mt-2 flex items-center gap-3 border border-border bg-page px-3 py-2 text-sm hover:border-accent hover:text-accent"
          href="https://t.me/bethetka"
          target="_blank"
          rel="noreferrer"
        >
          <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
          </svg>
          <span>t.me/bethetka</span>
        </a>
      </aside>

      <footer class="flex justify-end px-8 pb-8 md:col-span-2 md:px-10 md:pb-10">
        <a
          class="border border-border bg-page px-4 py-2 text-sm font-semibold hover:border-accent hover:text-accent"
          href="https://t.me/pmnullsqd"
          target="_blank"
          rel="noreferrer"
        >
          Contact
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>
